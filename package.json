{
    "name": "codeatlas-live",
    "displayName": "CodeAtlas-Live",
    "icon": "icon.png",
    "description": "Continuously builds and updates five linked diagram layers (Microservices, Features, API Sequences, File Dependencies, and Function Flowcharts) for multi-language codebases — with differential rendering, commenting, and source navigation.",
    "version": "9.3.0",
    "buildNumber": 158,
    "publisher": "codeatlaslive",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/vamsikk7/codeatlas-live"
    },
    "homepage": "https://codeatlas.live",
    "bugs": {
        "url": "https://github.com/vamsikk7/codeatlas-live-issues/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Programming Languages",
        "Education",
        "Linters",
        "Other"
    ],
    "keywords": [
        "diagram",
        "architecture",
        "visualization",
        "flowchart",
        "sequence diagram",
        "code mapping",
        "dependency graph",
        "microservice",
        "call graph",
        "code navigation",
        "code understanding",
        "api explorer",
        "uml",
        "class diagram",
        "flow diagram",
        "codebase",
        "javascript",
        "typescript",
        "java",
        "python",
        "spring boot",
        "django",
        "diff",
        "git diff",
        "code review",
        "refactoring",
        "code analysis",
        "static analysis",
        "developer tools",
        "productivity",
        "mobile",
        "android",
        "ios",
        "react-native",
        "kotlin",
        "swift",
        "compose",
        "swiftui",
        "navigation",
        "screens",
        "next.js",
        "graphql"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onUri"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "CodeAtlas parses and indexes workspace source files to build its diagrams, which requires Workspace Trust. In Restricted Mode the extension stays paused — trust this workspace to start indexing."
        }
    },
    "main": "./dist/extension.js",
    "contributes": {
        "keybindings": [
            {
                "command": "codeatlas.openMicroserviceDiagram",
                "key": "ctrl+shift+d",
                "mac": "cmd+shift+d"
            },
            {
                "command": "codeatlas.searchApiExplorer",
                "key": "ctrl+shift+a",
                "mac": "cmd+shift+a"
            },
            {
                "command": "codeatlas.initializeWorkspaceVisuals",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i"
            },
            {
                "command": "codeatlas.search",
                "key": "ctrl+shift+f5",
                "mac": "cmd+shift+f5"
            },
            {
                "command": "codeatlas.replayPrev",
                "key": "left",
                "mac": "left",
                "when": "codeatlas:replayActive"
            },
            {
                "command": "codeatlas.replayNext",
                "key": "right",
                "mac": "right",
                "when": "codeatlas:replayActive"
            },
            {
                "command": "codeatlas.replayToggle",
                "key": "space",
                "mac": "space",
                "when": "codeatlas:replayActive"
            },
            {
                "command": "codeatlas.replayStop",
                "key": "escape",
                "mac": "escape",
                "when": "codeatlas:replayActive"
            }
        ],
        "commands": [
            {
