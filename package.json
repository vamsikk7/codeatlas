        "menus": {
            "view/title": [
                {
                    "command": "codeatlas.searchApiExplorer",
                    "when": "view == codeatlas.apiExplorer",
                    "group": "navigation"
                },
                {
                    "command": "codeatlas.searchFunctionExplorer",
                    "when": "view == codeatlas.functionExplorer",
                    "group": "navigation"
                },
                {
                    "command": "codeatlas.searchFileExplorer",
                    "when": "view == codeatlas.fileExplorer",
                    "group": "navigation"
                },
                {
                    "command": "codeatlas.searchFeatureExplorer",
                    "when": "view == codeatlas.featureExplorer",
                    "group": "navigation"
                },
                {
                    "command": "codeatlas.openInBrowser",
                    "when": "view == codeatlas.microserviceExplorer",
                    "group": "navigation@0"
                },
                {
                    "command": "codeatlas.showHealthReport",
                    "when": "view == codeatlas.functionExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "codeatlas.analyzeImpact",
                    "when": "view == codeatlas.functionExplorer",
                    "group": "navigation@2"
                },
                {
                    "command": "codeatlas.openGitDiff",
                    "when": "view =~ /^codeatlas\\.(microserviceExplorer|featureExplorer|apiExplorer|fileExplorer|functionExplorer|changedItems|comments)$/ && !codeatlas:gitDiffActive",
                    "group": "navigation@99"
                },
                {
                    "command": "codeatlas.openPrDiff",
                    "when": "view =~ /^codeatlas\\.(microserviceExplorer|featureExplorer|apiExplorer|fileExplorer|functionExplorer|changedItems|comments)$/ && !codeatlas:gitDiffActive",
                    "group": "navigation@98"
                },
                {
                    "command": "codeatlas.clearGitDiff",
                    "when": "view =~ /^codeatlas\\.(microserviceExplorer|featureExplorer|apiExplorer|fileExplorer|functionExplorer|changedItems|comments)$/ && codeatlas:gitDiffActive",
                    "group": "navigation@99"
                }
            ],
            "view/item/context": [
                {
                    "command": "codeatlas.replayFromFile",
                    "when": "viewItem == changedGraph && codeatlas:gitDiffActive",
                    "group": "inline"
                },
                {
                    "command": "codeatlas.copyApiRoute",
                    "when": "viewItem == apiRoute",
                    "group": "inline"
                },
                {
                    "command": "codeatlas.analyzeImpact",
                    "when": "viewItem == functionItem",
                    "group": "inline"
                },
                {
                    "command": "codeatlas.analyzeImpact",
                    "when": "viewItem == fileItem",
                    "group": "1_impact"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codeatlas",
                    "title": "CodeAtlas",
                    "icon": "$(symbol-structure)"
                }
            ]
        },
        "views": {
            "codeatlas": [
                {
                    "id": "codeatlas.welcome",
                    "name": "Getting Started"
                },
                {
