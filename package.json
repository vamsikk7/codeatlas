        "configuration": {
            "title": "CodeAtlas",
            "properties": {
                "codeatlas.autoUpdateOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically update diagrams when files are saved."
                },
                "codeatlas.remindOpenSourceInterest": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an occasional (at most once per day) reminder to register interest in open-sourcing the CodeAtlas visual engine. Turn off to never show it."
                },
                "codeatlas.crossRepoPush": {
                    "type": "boolean",
                    "default": true,
                    "description": "Multi-repo workspaces: push live notifications to open browser tabs when one repo's API change affects another repo's consumed endpoints."
                },
                "codeatlas.replayCodaMaxConsumers": {
                    "type": "number",
                    "default": 5,
                    "description": "Multi-repo replay: maximum consumer repos walked by the cross-repo coda at the end of a producer's replay. Consumers beyond the cap are listed in a summary frame."
                },
                "codeatlas.maxFiles": {
                    "type": "number",
                    "default": 2000,
                    "description": "Maximum number of JS files to scan."
                },
                "codeatlas.maxFileSize": {
                    "type": "number",
                    "default": 5242880,
                    "description": "Skip files larger than this many bytes (defaults to 5 MB). Raise for large generated files (Prisma schemas, GraphQL codegen output, large Vue SFCs); lower if you hit parser timeouts on a slow machine."
                },
                "codeatlas.sequenceTraversalDepth": {
                    "type": "number",
                    "default": 8,
                    "description": "Maximum BFS depth when expanding sequence diagrams across imports. Increase for codebases with deep delegation chains; decrease to keep sequence graphs compact on huge codebases."
                },
                "codeatlas.storage.inMemoryOnly": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, CodeAtlas keeps state only in memory and never writes the .codeatlas/state.db file. State is rebuilt from source on every activation. Useful for ephemeral workspaces, secret-sensitive projects, or as a recovery option when the on-disk DB is corrupt."
                },
                "codeatlas.cascadeParallelism": {
                    "type": "string",
                    "enum": [
                        "off",
                        "tier1",
                        "tier2"
                    ],
                    "default": "tier2",
                    "description": "ADR-034 Phase D — multi-repo init parallelism. 'off' runs per-repo init serially (Phase B behaviour). 'tier1' caps in-process concurrency at min(8, cpu count) for a ~1.3-1.5x speedup. 'tier2' (default) parses each repo in its own worker_threads worker for real CPU parallelism — typically ~3-7x faster on multi-repo workspaces. If the worker pool fails to construct (e.g. WASM resolution error), CodeAtlas transparently falls back to tier1. No effect on single-repo workspaces."
                },
                "codeatlas.cascadeParallelismMigrated": {
                    "type": "boolean",
                    "default": false,
                    "description": "Internal one-shot marker — set automatically after the 7.1.0 upgrade flips a pre-7.1.0 'tier1' setting to 'tier2'. Don't edit manually; flipping cascadeParallelism back to 'tier1' is fully supported and persists across restarts."
                },
                "codeatlas.browserPort": {
                    "type": "number",
                    "default": 7742,
                    "description": "Port for the standalone browser UI server (localhost)."
                },
                "codeatlas.ignore": {
                    "type": "array",
                    "default": [],
                    "description": "Additional glob patterns to ignore during workspace scan. These are added to a baseline that already excludes node_modules, dist/build/out, .git, .next/.nuxt/.svelte-kit/.expo, __pycache__/.venv, target/.gradle, vendor, Pods/.swiftpm, .dart_tool, bin/obj, coverage, IDE state, and other framework dependency / build / cache directories. Add your repo-specific exclusions here."
                },
                "codeatlas.showUnchangedInDiagrams": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show unchanged elements in differential diagrams."
                },
                "codeatlas.sequence.apiDetectionMode": {
                    "type": "string",
                    "default": "heuristic",
                    "enum": [
                        "heuristic"
                    ],
                    "description": "API detection mode for sequence diagrams."
                },
                "codeatlas.diff.resetOnBranchChange": {
                    "type": "boolean",
                    "default": false,
                    "description": "Reset diff baseline when git branch changes."
                },
                "codeatlas.lspFallback": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable LSP fallback for receiver type resolution when tree-sitter fails (generics, re-exports, interface→impl). May increase CPU usage."
                },
                "codeatlas.lspTimeout": {
                    "type": "number",
                    "default": 2000,
                    "description": "Timeout in milliseconds for each LSP definition lookup."
                },
                "codeatlas.llmNaming": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable LLM-powered semantic naming for clusters and services. Requires a configured LLM provider."
                },
                "codeatlas.domainLlmRefinementEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Issue #733 — when enabled, the optional LLM refiner re-names and re-calibrates the heuristic Domain clusters (Issue #701) on top of the deterministic output. The heuristic system stays the source of truth; the LLM never replaces it, only enhances. Requires a configured LLM provider. Toggle from the Domains card on the Home page."
                },
                "codeatlas.llmProvider": {
                    "type": "string",
                    "default": "openrouter",
                    "enum": [
                        "openrouter",
                        "openai",
                        "anthropic",
                        "ollama",
                        "custom"
                    ],
                    "enumDescriptions": [
                        "OpenRouter — access 200+ models, free tier available, BYOK supported",
                        "OpenAI — use your own OpenAI API key directly (gpt-4o, gpt-4o-mini, etc.)",
                        "Anthropic — use your own Anthropic API key directly (claude-sonnet, claude-haiku, etc.)",
                        "Ollama — local LLM via Ollama (no API key required, default: http://localhost:11434)",
                        "Custom — any OpenAI-compatible endpoint (set URL in codeatlas.llmEndpoint)"
                    ],
                    "description": "LLM provider for semantic naming and AI queries. Set your API key via 'CodeAtlas: Set LLM API Key' command (not required for Ollama)."
                },
                "codeatlas.llmModel": {
                    "type": "string",
                    "default": "openrouter/free",
                    "description": "Model ID. OpenRouter: 'openrouter/free' or 'openrouter/auto'. OpenAI: 'gpt-4o-mini'. Anthropic: 'claude-sonnet-4-20250514'. Ollama: 'llama3', 'codellama', 'mistral'."
                },
                "codeatlas.llmEndpoint": {
                    "type": "string",
                    "default": "",
                    "description": "Custom endpoint URL for LLM API. Used when provider is 'ollama' or 'custom'. Leave empty for provider defaults. Example: http://localhost:11434/v1/chat/completions"
                },
                "codeatlas.evidenceGateEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "AI Review evidence gate (#513): when enabled, findings must quote source verbatim or they are dropped. Toggle off only for debugging — when off, the model's unfiltered output is kept."
                },
                "codeatlas.aiReview.maxBudgetUSD": {
                    "type": "number",
                    "default": 1,
                    "description": "Aggregate USD budget for a single AI Review run (#608). When the running cost reaches this cap, the review aborts and any findings already kept are persisted. Set to 0 to disable the budget guard (no cap)."
                },
                "codeatlas.aiReview.smallModelFallback": {
                    "type": "string",
                    "default": "",
                    "description": "Optional fallback model id used by small-coder reviews (#605) when the primary model returns zero findings after the re-quote retry. Example: 'openai/gpt-4o-mini'. Leave blank to disable fallback."
                },
                "codeatlas.health.godFileThreshold": {
                    "type": "number",
                    "default": 15,
                    "description": "Minimum symbol count to flag a file as a 'god file'."
                },
                "codeatlas.health.highCouplingThreshold": {
                    "type": "number",
                    "default": 10,
                    "description": "Edge count (per direction) to flag a file as high-coupling."
                },
                "codeatlas.health.deadCodeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable dead code detection in health analysis."
                }
            }
        }
    },
    "scripts": {
        "download-grammars": "node scripts/copy-grammars.js",
        "postinstall": "npm run download-grammars",
        "compile": "node esbuild.js",
        "compile:prod": "node esbuild.js --package",
        "watch": "node esbuild.js --watch",
        "build:webview": "cd webview-ui && npm run build",
        "bump-build": "node scripts/bump-build.js",
        "package": "npm run compile:prod && npm run build:webview",
        "package:dev": "npm run bump-build && npm run compile:prod && npm run build:webview",
        "package:npm": "npm run compile:prod && npm run build:webview && node scripts/build-mcp-package.js && cd mcp-package && npm pack --ignore-scripts",
        "vscode:prepublish": "npm run package",
        "audit:release": "node scripts/audit-release-packages.js",
        "publish:ovsx": "npx ovsx publish -p $OPENVSX_TOKEN",
        "test": "vitest run && cd webview-ui && npm test",
        "test:watch": "vitest",
        "test:standalone": "vitest run src/standalone/__tests__/",
        "lint": "tsc --noEmit",
        "lint:catches": "npx tsx scripts/lint-silent-catches.ts",
        "lint:issue-comments": "node scripts/lint-issue-comments.js",
        "pretest:e2e": "find e2e/test-results -mindepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null || true",
        "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
        "test:e2e:headed": "npx playwright test --config e2e/playwright.config.ts --headed",
        "fetch:real-projects": "bash e2e/real-projects/fetch.sh",
        "verify:mcp-smoke": "node e2e/scripts/mcp-smoke.js",
        "verify:mcp-tools": "node e2e/scripts/mcp-all-tools-probe.js",
        "verify:standalone": "node e2e/scripts/mcp-standalone-live-verify.js",
        "verify:ai-review:mcp": "node e2e/scripts/mcp-ai-review-verify.mcp.js",
        "verify:ai-review:ext": "node e2e/scripts/mcp-ai-review-verify.ext.js",
        "verify:all37": "bash e2e/scripts/all37-leak-probe.sh",
        "verify:real": "vitest run --config e2e/real-projects/vitest.config.ts e2e/real-projects/verify.test.ts",
